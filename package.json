{
  "name": "discourse-contained-html",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "lint": "pnpm lint:js && pnpm lint:css && pnpm lint:prettier",
    "lint:js": "eslint '{assets,admin/assets,test}/javascripts/**/*.{js,gjs}' --no-error-on-unmatched-pattern",
    "lint:css": "stylelint 'assets/stylesheets/**/*.scss' --allow-empty-input",
    "lint:prettier": "prettier '**/*.{js,gjs,json,md,scss,yml}' --ignore-path .gitignore --check"
  },
  "devDependencies": {
    "@discourse/lint-configs": "3.2.0",
    "eslint": "10.6.0",
    "prettier": "3.8.1",
    "stylelint": "17.5.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": "^10"
  },
  "packageManager": "pnpm@10.28.0"
}
